<mujoco model="bimanual_tabletop_challenge">
  <compiler angle="radian" meshdir="SO-ARM100/Simulation/SO101/assets" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <!-- Shared Motor and Friction Defaults -->
  <default>
    <default class="so101_new_calib">
      <joint damping="1" frictionloss="0.1" armature="0.005"/>
      <position kp="50"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>
    <default class="sts3215">
      <geom contype="0" conaffinity="0"/>
      <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
      <position kp="998.22" kv="2.731" forcerange="-2.94 2.94"/>
    </default>
    <default class="backlash">
      <joint damping="0.01" frictionloss="0" armature="0.01" limited="true" range="-0.008726 0.008726"/>
    </default>
  </default>

  <!-- Shared 3D Meshes and Materials -->
  <asset>
    <mesh file="waveshare_mounting_plate_so101_v2.stl"/>
    <mesh file="sts3215_03a_v1.stl"/>
    <mesh file="motor_holder_so101_base_v1.stl"/>
    <mesh file="wrist_roll_follower_so101_v1.stl"/>
    <mesh file="moving_jaw_so101_v1.stl"/>
    <mesh file="base_motor_holder_so101_v1.stl"/>
    <mesh file="upper_arm_so101_v1.stl"/>
    <mesh file="wrist_roll_pitch_so101_v2.stl"/>
    <mesh file="under_arm_so101_v1.stl"/>
    <mesh file="rotation_pitch_so101_v1.stl"/>
    <mesh file="motor_holder_so101_wrist_v1.stl"/>
    <mesh file="sts3215_03a_no_horn_v1.stl"/>
    <mesh file="base_so101_v2.stl"/>

    <material name="base_motor_holder_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="base_so101_v2_material" rgba="1 0.82 0.12 1"/>
    <material name="sts3215_03a_v1_material" rgba="0.1 0.1 0.1 1"/>
    <material name="waveshare_mounting_plate_so101_v2_material" rgba="1 0.82 0.12 1"/>
    <material name="motor_holder_so101_base_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="rotation_pitch_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="upper_arm_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="under_arm_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="motor_holder_so101_wrist_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="sts3215_03a_no_horn_v1_material" rgba="0.1 0.1 0.1 1"/>
    <material name="wrist_roll_pitch_so101_v2_material" rgba="1 0.82 0.12 1"/>
    <material name="wrist_roll_follower_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="moving_jaw_so101_v1_material" rgba="1 0.82 0.12 1"/>
  </asset>

  <!-- Tabletop World -->
  <worldbody>
    <light name="main_light" diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.92 0.92 0.92 1"/>

    <!-- Worktable (Top surface at z = 0.70m) -->
    <geom name="table" type="box" size="0.6 0.45 0.02" pos="0 0 0.68" rgba="0.82 0.72 0.62 1"/>

    <!-- Overhead Camera for Vision / VLA reasoning -->
    <camera name="overhead_cam" pos="0 0 1.6" euler="0 0 0"/>

    <!-- Mug (Placed on Arm B's side) -->
    <body name="mug" pos="0.05 0.15 0.745">
      <freejoint/>
      <geom name="mug_geom" type="cylinder" size="0.035 0.04" mass="0.12" friction="1.5 0.01 0.001" rgba="0.2 0.4 0.8 1"/>
      <site name="mug_site" pos="0 0 0"/>
    </body>

    <!-- Desktop Drawer Unit (Sitting on table in front of Arm A) -->
    <body name="drawer_unit" pos="0.10 -0.22 0.74">
      <!-- Housing / Casing (Visual only so it doesn't crush the plate) -->
      <geom name="casing_top" type="box" size="0.09 0.09 0.004" pos="0 0 0.04" rgba="0.45 0.32 0.20 1" contype="0" conaffinity="0"/>
      <geom name="casing_back" type="box" size="0.004 0.09 0.04" pos="0.086 0 0" rgba="0.45 0.32 0.20 1" contype="0" conaffinity="0"/>

      <!-- Movable Drawer Section (Slides towards -X along Arm A's reach) -->
      <body name="sliding_tray" pos="0 0 0">
        <joint name="drawer_slide" type="slide" axis="-1 0 0" range="0 0.15" damping="1.0" frictionloss="0.05"/>
        <!-- Floor of the tray where the plate rests -->
        <geom name="tray_floor" type="box" size="0.08 0.08 0.005" pos="0 0 -0.035" rgba="0.65 0.52 0.38 1" friction="1.0 0.01 0.001"/>
        <geom name="tray_back" type="box" size="0.005 0.08 0.03" pos="0.075 0 0" rgba="0.55 0.45 0.35 1"/>
        <!-- Front Wall -->
        <geom name="tray_front" type="box" size="0.005 0.08 0.03" pos="-0.075 0 0" rgba="0.55 0.45 0.35 1"/>

        <!-- Robust D-Handle: Standoff posts + Front Crossbar for secure gripper hook/pinch -->
        <geom name="handle_post_left" type="cylinder" size="0.004 0.012" pos="-0.090 0.030 0" euler="0 1.5708 0" rgba="0.2 0.2 0.2 1"/>
        <geom name="handle_post_right" type="cylinder" size="0.004 0.012" pos="-0.090 -0.030 0" euler="0 1.5708 0" rgba="0.2 0.2 0.2 1"/>
        <geom name="drawer_handle" type="cylinder" size="0.007 0.035" pos="-0.102 0 0" euler="1.5708 0 0" rgba="0.1 0.1 0.1 1" friction="1.8 0.01 0.001"/>
        <site name="drawer_handle_site" pos="-0.102 0 0"/>
      </body>
    </body>

    <!-- Plate (Top-level body with freejoint, starts resting inside the tray floor) -->
    <body name="plate" pos="0.10 -0.22 0.72">
      <freejoint/>
      <geom name="plate_geom" type="cylinder" size="0.055 0.006" mass="0.10" friction="1.2 0.01 0.001" rgba="0.95 0.95 0.95 1"/>
      <site name="plate_site" pos="0 0 0"/>
    </body>

    <!-- Water Bottle (For Arm A pouring into Arm B's mug) -->
    <body name="water_bottle" pos="0.08 -0.06 0.76">
      <freejoint/>
      <!-- Bottle main body -->
      <geom name="bottle_body" type="cylinder" size="0.026 0.050" mass="0.14" friction="1.5 0.01 0.001" rgba="0.15 0.65 0.85 0.85"/>
      <!-- Bottle neck and cap -->
      <geom name="bottle_cap" type="cylinder" size="0.012 0.014" pos="0 0 0.064" mass="0.01" friction="1.5 0.01 0.001" rgba="0.9 0.9 0.9 1"/>
      <site name="bottle_site" pos="0 0 0"/>
    </body>

    <!-- Spoon (Dinner setting utensil) -->
    <body name="spoon" pos="0.14 0.04 0.705">
      <freejoint/>
      <geom name="spoon_handle" type="box" size="0.004 0.035 0.002" mass="0.015" friction="1.2 0.01 0.001" rgba="0.75 0.75 0.80 1"/>
      <geom name="spoon_bowl" type="sphere" size="0.012" pos="0 0.042 0.002" mass="0.01" friction="1.2 0.01 0.001" rgba="0.75 0.75 0.80 1"/>
      <site name="spoon_site" pos="0 0 0"/>
    </body>

    <!-- Fork (Dinner setting utensil) -->
    <body name="fork" pos="0.14 -0.04 0.705">
      <freejoint/>
      <geom name="fork_handle" type="box" size="0.004 0.035 0.002" mass="0.015" friction="1.2 0.01 0.001" rgba="0.75 0.75 0.80 1"/>
      <geom name="fork_prongs" type="box" size="0.008 0.012 0.002" pos="0 0.042 0" mass="0.01" friction="1.2 0.01 0.001" rgba="0.75 0.75 0.80 1"/>
      <site name="fork_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <!-- Prevent accidental contact glitches between housing and plate -->
  <contact>
    <exclude body1="plate" body2="drawer_unit"/>
  </contact>

  <!-- Top-level robot includes -->
  <include file="SO-ARM100/Simulation/SO101/so101_arm_a.xml"/>
  <include file="SO-ARM100/Simulation/SO101/so101_arm_b.xml"/>
</mujoco>
